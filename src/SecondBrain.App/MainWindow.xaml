<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="SecondBrain.App.MainWindow" Title="Second Brain" Style="{StaticResource ShellWindowStyle}" Width="1000" Height="790" MinWidth="620" MinHeight="480" WindowStartupLocation="CenterScreen">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,16">
      <Button x:Name="NavigationToggle" Content="Compact menu" Click="NavigationToggle_Click" DockPanel.Dock="Right" HorizontalAlignment="Right" Padding="10,4" Margin="12,0,0,0" />
      <TextBlock Text="SECOND BRAIN" FontSize="18" FontWeight="Bold" />
      <TextBlock Text="LIVE MEETING COMPANION" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right" />
    </DockPanel>
    <ScrollViewer x:Name="WorkspaceScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
      <Grid x:Name="WorkspaceGrid" MinHeight="520" MinWidth="650" Width="{Binding ElementName=WorkspaceScroll, Path=ViewportWidth}" Height="{Binding ElementName=WorkspaceScroll, Path=ViewportHeight}">
        <TabControl x:Name="WorkspaceTabs" TabStripPlacement="Left" SelectionChanged="Workspace_SelectionChanged">
          <TabItem Header="Live" x:Name="LiveTab" MinWidth="112" ToolTip="Live" AutomationProperties.Name="Live">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="20">
                <DockPanel Margin="0,0,0,16">
                  <Border x:Name="SessionStateBadge" DockPanel.Dock="Right" HorizontalAlignment="Right" Background="{StaticResource Subtle}" BorderBrush="{StaticResource Ink}" BorderThickness="2" Padding="10,5" CornerRadius="2">
                    <TextBlock x:Name="SessionStateText" Text="READY" FontWeight="Bold" FontSize="11" AutomationProperties.Name="Session state" />
                  </Border>
                  <TextBlock Text="Live" Style="{StaticResource PageTitle}" Margin="0" />
                </DockPanel>
                <DockPanel Margin="0,0,0,8"><ComboBox x:Name="ClientPicker" DisplayMemberPath="DisplayName" SelectionChanged="ClientPicker_Changed" Width="210" DockPanel.Dock="Left" Margin="0,0,12,0" AutomationProperties.Name="Client profile"/><TextBlock x:Name="MeetingBriefSummary" Text="General meeting" VerticalAlignment="Center" TextWrapping="Wrap" MaxHeight="40" FontSize="12" Foreground="{StaticResource Muted}"/></DockPanel>
<Expander x:Name="MeetingBriefExpander" Header="Meeting brief" Margin="0,0,0,12"><StackPanel x:Name="ContextEditor" Margin="0,10,0,0">
<TextBlock Text="Client name (blank for a general meeting)"/><TextBox x:Name="ContextClient" MaxLength="120" TextChanged="ContextField_Changed" AutomationProperties.Name="Client name"/>
<TextBlock Text="Project filter (optional; exact project name in your notes)" Margin="0,8,0,0"/><TextBox x:Name="ContextProject" MaxLength="120" TextChanged="ContextField_Changed" AutomationProperties.Name="Meeting project"/>
<TextBlock Text="Goal for this meeting" Margin="0,8,0,0"/><TextBox x:Name="ContextGoal" MaxLength="2000" AcceptsReturn="True" TextWrapping="Wrap" Height="70" VerticalScrollBarVisibility="Auto" TextChanged="ContextField_Changed" AutomationProperties.Name="Meeting goal"/>
<TextBlock Text="Expected participants · one name per line (up to 50)" Margin="0,8,0,0"/><TextBox x:Name="ContextParticipants" MaxLength="5050" AcceptsReturn="True" TextWrapping="Wrap" Height="65" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Expected participants"/>
<TextBlock Text="Work vocabulary · one term per line (up to 100)" Margin="0,8,0,0"/><TextBox x:Name="ContextVocabulary" MaxLength="8100" AcceptsReturn="True" TextWrapping="Wrap" Height="65" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Work vocabulary"/>
<WrapPanel Margin="0,10,0,8"><Button Content="Save brief" Click="SaveContext_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"/><Button Content="New client" Click="NewContext_Click"/></WrapPanel>
<TextBlock x:Name="ContextStatus" Text="Save a brief to reuse it. Starting a session saves the current brief and keeps that meeting’s copy fixed." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}"/>
</StackPanel></Expander><WrapPanel Margin="0,0,0,10">
                  <Button x:Name="ListenButton" Content="Start listening" Click="Listen_Click" Padding="20,12" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" />
                  <Button Content="Open reader" Click="OpenReader_Click" Padding="16,12" Margin="10,0,0,0" />
                </WrapPanel>
                <DockPanel Margin="0,0,0,8">
                  <Button Content="Audio settings" Click="AudioSettings_Click" DockPanel.Dock="Right" Padding="8,4" Margin="10,0,0,0" FontSize="12" />
                  <TextBlock Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center">
                    <TextBlock.Text>
                      <MultiBinding StringFormat="Mic: {0} · Output: {1}">
                        <Binding ElementName="MicrophonePicker" Path="SelectedItem.Name" TargetNullValue="Not selected" />
                        <Binding ElementName="LiveOutputPicker" Path="SelectedItem.Name" TargetNullValue="Not selected" />
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                </DockPanel>
                <TextBlock x:Name="CompanionStatus" Text="Ready when you are. Start listening to get answers during your meeting." TextWrapping="Wrap" Margin="0,0,0,12" />
                <Border Style="{StaticResource CardSurface}" Padding="16">
                  <StackPanel>
                    <TextBlock x:Name="CurrentQuestion" Text="Your next answer" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12" FontSize="18" />
                    <TextBox x:Name="LiveAnswer" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="150" MaxHeight="240" FontSize="20" BorderThickness="0" Padding="0" Text="Answers will appear here and in your reader when a question comes through." AutomationProperties.Name="Current answer" />
                  </StackPanel>
                </Border>
                <WrapPanel Margin="0,10,0,10">
                  <Button Content="Previous answer" Click="CompanionPrevious_Click" Padding="8,6" Margin="0,0,6,5" />
                  <Button Content="Next answer" Click="CompanionNext_Click" Padding="8,6" Margin="0,0,6,5" />
                  <Button Content="Resume following" Click="ResumeFollowing_Click" Padding="8,6" Margin="0,0,6,5" />
                </WrapPanel>
                <DockPanel Margin="0,0,0,8">
                  <CheckBox x:Name="FlowCheck" Content="Keep this answer flowing as I read" IsChecked="True" Click="FlowCheck_Click" ToolTip="Appends grounded detail near the end during voice or timed following. Manual navigation never requests more text." />
                </DockPanel>
                <DockPanel Margin="0,0,0,8">
                  <Button x:Name="LiveAsk" Content="Ask" DockPanel.Dock="Right" Click="LiveAsk_Click" Padding="12,6" />
                  <TextBox x:Name="LiveQuestion" MaxLength="2000" ToolTip="Optional typed question while listening" AutomationProperties.Name="Ask about this meeting" />
                </DockPanel>
                <Expander Header="Evidence for this answer" Margin="0,4,0,0" x:Name="LiveEvidence" IsExpanded="False">
                  <StackPanel>
                    <TextBlock x:Name="SourceStatus" Text="Relevant vault passages will appear here, separate from the spoken answer." TextWrapping="Wrap" FontSize="11" />
                    <ListBox x:Name="LiveSources" MaxHeight="200" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    <Button Content="Open selected source in Obsidian" Click="SourceOpen_Click" HorizontalAlignment="Left" Padding="8,5" />
                  </StackPanel>
                </Expander>
                <Expander x:Name="LatencyDetails" Header="Answer timing" Margin="0,10,0,0" IsExpanded="False">
                  <StackPanel Margin="0,8,0,0">
                    <TextBlock x:Name="TimingSummary" Text="No answer timings yet." TextWrapping="Wrap" />
                    <TextBlock Text="Cold/warm groups mean first/later requests in this session; provider cache state is unknown. Speech end uses the last timed word. Readable means text ready, not measured screen presentation. Typed questions have no speech timing." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0" />
                    <Button x:Name="ExportTiming" Content="Export timing report…" Click="ExportTiming_Click" IsEnabled="False" HorizontalAlignment="Left" Margin="0,8,0,0" />
                    <TextBlock x:Name="TimingMessage" Text="Timings are saved with the meeting when listening stops." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" />
                  </StackPanel>
                </Expander>
                <Expander x:Name="LiveDetails" Header="Live transcript &amp; capture details" Margin="0,10,0,0" IsExpanded="False">
                  <StackPanel Margin="0,8,0,0">
                    <TextBlock x:Name="CaptureStatus" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8" />
                    <TextBlock x:Name="LiveMic" Text="Microphone · waiting" TextWrapping="Wrap" MaxHeight="65" Margin="0,0,0,6" />
                    <TextBlock x:Name="LiveSystem" Text="Computer audio · waiting" TextWrapping="Wrap" MaxHeight="65" Margin="0,0,0,10" />
                    <TextBlock Text="Listening records both sources locally and sends audio to Deepgram. Questions and selected context are sent to OpenAI." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" />
                  </StackPanel>
                </Expander>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem x:Name="MeetingsTab" MinWidth="112" ToolTip="Meetings" AutomationProperties.Name="Meetings" Header="Meetings">
            <TabControl>
              <TabItem Header="Recordings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel Margin="20">
                    <TextBlock Text="Saved meetings" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Audio and transcripts from your sessions, kept on this computer." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,16" />
                    <Button Content="Refresh meetings" Click="MeetingsRefresh_Click" HorizontalAlignment="Left" />
                    <TextBlock x:Name="MeetingListStatus" Text="Open Meetings to load saved sessions." TextWrapping="Wrap" Margin="0,12,0,8" />
                    <ListBox x:Name="MeetingList" MinHeight="220" MaxHeight="380" DisplayMemberPath="Label" AutomationProperties.Name="Saved meetings" />
                    <Button Content="Open selected meeting folder" Click="MeetingFolder_Click" HorizontalAlignment="Left" Margin="0,12,0,0" />
                    <Button Content="View selected transcript" Click="MeetingTranscript_Click" HorizontalAlignment="Left" Margin="0,8,0,0" />
                    <TextBlock Text="Your audio tracks and transcript are inside each meeting folder." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,12,0,0" />
                  </StackPanel>
                </ScrollViewer>
              </TabItem>
              <TabItem x:Name="HistoryTab" Header="Note history">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel Margin="18">
                    <TextBlock Text="Your notes, with a history" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="Meeting updates add dated sections with transcript sources. Manual edits are saved before AI changes. This history stays locally inside your vault; nothing is pushed online." TextWrapping="Wrap" Margin="0,8,0,12" />
                    <TextBlock x:Name="MaintenanceStatus" Text="Opening local history…" TextWrapping="Wrap" />
                    <WrapPanel Margin="0,8,0,8">
                      <Button Content="Refresh history" Click="HistoryRefresh_Click" Padding="8,6" Margin="0,0,6,6" />
                      <Button x:Name="HistoryScan" Content="Update saved meetings" Click="HistoryScan_Click" Padding="8,6" Margin="0,0,6,6" />
                      <Button x:Name="HistoryRetry" Content="Retry pending" Click="HistoryRetry_Click" Padding="8,6" Margin="0,0,6,6" />
                      <Button x:Name="HistoryRecover" Content="Recover interrupted update" Click="HistoryRecover_Click" Padding="8,6" Margin="0,0,6,6" />
                    </WrapPanel>
                    <TextBlock x:Name="HistoryMessage" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <Expander Header="Update jobs">
                      <TextBlock x:Name="HistoryJobs" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,8" />
                    </Expander>
                    <TextBlock Text="Applied meeting updates" FontWeight="SemiBold" Margin="0,10,0,5" />
                    <ListBox x:Name="HistoryUpdates" Height="100" />
                    <Button x:Name="HistoryUndo" Content="Undo selected meeting update" Click="HistoryUndo_Click" HorizontalAlignment="Left" Padding="8,6" Margin="0,6,0,6" />
                    <TextBlock Text="Undo removes only that generated section. If you edited the section itself, a conflict is shown and your file is preserved." TextWrapping="Wrap" FontSize="11" />
                    <TextBlock Text="Saved revisions · newest first" FontWeight="SemiBold" Margin="0,12,0,5" />
                    <ListBox x:Name="HistoryRevisions" Height="120" />
                    <Button Content="Show selected changes" Click="HistoryDiff_Click" HorizontalAlignment="Left" Padding="8,6" Margin="0,6,0,6" />
                    <TextBox x:Name="HistoryDiff" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" Height="240" Text="Select a revision to inspect its changes." />
                  </StackPanel>
                </ScrollViewer>
              </TabItem>
            </TabControl>
          </TabItem>
          <TabItem Header="Knowledge" x:Name="KnowledgeTab" MinWidth="112" ToolTip="Knowledge" AutomationProperties.Name="Knowledge">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="18">
                <TextBlock Text="Your Markdown vault" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="The companion and Obsidian use this same folder. Notes remain beside the app by default; links become edges in Obsidian’s graph." TextWrapping="Wrap" Margin="0,8,0,12" />
                <TextBox x:Name="VaultFolder" ToolTip="Vault folder" />
                <WrapPanel Margin="0,8,0,8">
                  <Button x:Name="VaultChoose" Content="Choose folder…" Click="VaultChoose_Click" Padding="8,6" Margin="0,0,6,6" />
                  <Button Content="Open folder" Click="VaultExplorer_Click" Padding="8,6" Margin="0,0,6,6" />
                  <Button Content="Open in Obsidian" Click="VaultObsidian_Click" Padding="8,6" Margin="0,0,6,6" />
                </WrapPanel>
                <CheckBox x:Name="SemanticCheck">
                  <TextBlock Text="Semantic search: sends Markdown passages to OpenAI for embeddings (API usage)" TextWrapping="Wrap" />
                </CheckBox>
                <CheckBox x:Name="AutoUpdates" Margin="0,8,0,0">
                  <TextBlock Text="Automatically update notes after meetings (OpenAI API use; local history and undo)" TextWrapping="Wrap" />
                </CheckBox>
                <TextBlock Text="Project filter (exact project: frontmatter value; blank means all)" TextWrapping="Wrap" Margin="0,12,0,4" />
                <TextBox x:Name="VaultProject" MaxLength="120" />
                <TextBlock Text="Date range · YYYY-MM-DD (blank means unrestricted)" Margin="0,8,0,4" />
                <UniformGrid Columns="2">
                  <TextBox x:Name="VaultFrom" ToolTip="From date" Margin="0,0,6,0" />
                  <TextBox x:Name="VaultUntil" ToolTip="Until date" />
                </UniformGrid>
                <WrapPanel Margin="0,8,0,10">
                  <Button x:Name="VaultApply" Content="Apply vault and filters" Click="VaultApply_Click" Padding="8,6" Margin="0,0,6,6" />
                  <Button Content="Rebuild index" Click="VaultRebuild_Click" Padding="8,6" Margin="0,0,6,6" />
                  <Button x:Name="VaultImport" Content="Import saved meetings" Click="VaultImport_Click" Padding="8,6" Margin="0,0,6,6" />
                </WrapPanel>
                <TextBlock Text="New sessions export transcripts and linked excerpt summaries when stopped. Import saved meetings brings earlier sessions into this vault without changing original recordings." TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8" />
                <TextBlock x:Name="VaultStatus" TextWrapping="Wrap" Margin="0,0,0,12" />
                <DockPanel>
                  <Button x:Name="VaultSearch" Content="Search" Click="VaultSearch_Click" DockPanel.Dock="Right" Padding="10,6" />
                  <TextBox x:Name="VaultQuery" MaxLength="2000" ToolTip="Search notes and previous meetings" />
                </DockPanel>
                <TextBlock x:Name="VaultSearchStatus" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,6" />
                <ListBox x:Name="VaultResults" Height="200" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                <Button Content="Open selected note in Obsidian" Click="VaultOpenResult_Click" Padding="8,6" HorizontalAlignment="Left" Margin="0,8,0,0" />
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem x:Name="SettingsTab" MinWidth="112" ToolTip="Settings" AutomationProperties.Name="Settings" Header="Settings">
            <TabControl x:Name="SettingsTabs">
              <TabItem x:Name="DevicesTab" Header="Audio &amp; reader">
                <Border Style="{StaticResource CardSurface}" Padding="20" MaxWidth="780" HorizontalAlignment="Stretch">
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                      <DockPanel Margin="0,0,0,6">
                        <Button x:Name="RefreshMicrophonesButton" DockPanel.Dock="Right" Content="Refresh" Click="RefreshMicrophones_Click" Padding="8,4" />
                        <TextBlock Text="Microphone" FontSize="12" VerticalAlignment="Center" />
                      </DockPanel>
                      <ComboBox x:Name="MicrophonePicker" DisplayMemberPath="Name" SelectionChanged="Microphone_Changed" Padding="5" FontSize="12" AutomationProperties.Name="Microphone input" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=SelectedItem.Name}" />
                      <TextBlock Text="{Binding ElementName=MicrophonePicker, Path=SelectedItem.Name}" TextWrapping="Wrap" FontSize="11" Margin="0,5,0,6" Foreground="{StaticResource Muted}" />
                      <TextBlock Text="Used for both recording and voice following." TextWrapping="Wrap" FontSize="11" Margin="0,0,0,18" Foreground="{StaticResource Muted}" />
                      <TextBlock Text="Meeting computer-audio output" FontSize="12" />
                      <ComboBox x:Name="LiveOutputPicker" DisplayMemberPath="Name" Padding="5" Margin="0,6,0,8" />
                      <TextBlock Text="Choose the headphones or speakers your meeting plays through." TextWrapping="Wrap" FontSize="11" Margin="0,0,0,18" Foreground="{StaticResource Muted}" />
                      <TextBlock Text="Make it comfortable" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,18" />
                      <TextBlock Text="Text size" FontSize="12" />
                      <DockPanel>
                        <TextBlock Text="{Binding ElementName=FontSlider, Path=Value, StringFormat={}{0:F0} px}" DockPanel.Dock="Right" Width="48" TextAlignment="Right" />
                        <Slider x:Name="FontSlider" Minimum="18" Maximum="64" Value="32" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Appearance_Changed" AutomationProperties.Name="Text size" />
                      </DockPanel>
                      <TextBlock Text="Column width" FontSize="12" Margin="0,18,0,3" />
                      <DockPanel>
                        <TextBlock Text="{Binding ElementName=WidthSlider, Path=Value, StringFormat={}{0:F0} ch}" DockPanel.Dock="Right" Width="48" TextAlignment="Right" />
                        <Slider x:Name="WidthSlider" Minimum="20" Maximum="72" Value="36" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Appearance_Changed" AutomationProperties.Name="Column width" />
                      </DockPanel>
                      <TextBlock Text="Line spacing" FontSize="12" Margin="0,18,0,3" />
                      <DockPanel>
                        <TextBlock Text="{Binding ElementName=SpacingSlider, Path=Value, StringFormat={}{0:F1}×}" DockPanel.Dock="Right" Width="48" TextAlignment="Right" />
                        <Slider x:Name="SpacingSlider" Minimum="1.1" Maximum="2.2" Value="1.4" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="Appearance_Changed" AutomationProperties.Name="Line spacing" />
                      </DockPanel>
                      <TextBlock Text="Background opacity" FontSize="12" Margin="0,18,0,3" />
                      <DockPanel>
                        <TextBlock Text="{Binding ElementName=OpacitySlider, Path=Value, StringFormat={}{0:F0}%}" DockPanel.Dock="Right" Width="48" TextAlignment="Right" />
                        <Slider x:Name="OpacitySlider" Minimum="25" Maximum="100" Value="94" ValueChanged="Appearance_Changed" AutomationProperties.Name="Background opacity" />
                      </DockPanel>
                      <TextBlock Text="Reading band position" FontSize="12" Margin="0,18,0,3" />
                      <DockPanel>
                        <TextBlock Text="{Binding ElementName=BandSlider, Path=Value, StringFormat={}{0:F0}%}" DockPanel.Dock="Right" Width="48" TextAlignment="Right" />
                        <Slider x:Name="BandSlider" Minimum="15" Maximum="70" Value="33" ValueChanged="Appearance_Changed" AutomationProperties.Name="Reading band position" />
                      </DockPanel>
                      <Button Content="Add reader panel" Click="AddPanel_Click" Padding="10,8" Margin="0,14,0,0" HorizontalAlignment="Left" />
                      <StackPanel x:Name="DiagnosticControls">
                        <Button Content="Reading comparison" Click="ReadingStudy_Click" Padding="10,8" Margin="0,18,0,0" HorizontalAlignment="Left" FontSize="12" />
                        <Button x:Name="ReplayButton" Content="Replay speech pauses" Click="ReplaySpeech_Click" Padding="10,8" Margin="0,8,0,0" HorizontalAlignment="Left" FontSize="12" ToolTip="Replay dummy recognition events against the first 15 script words. No microphone or network." />
                      </StackPanel>
                      <CheckBox x:Name="RememberPosition" Content="Remember panel layouts" Margin="0,24,0,0" Checked="RememberPosition_Changed" Unchecked="RememberPosition_Changed" FontSize="12" />
                      <TextBlock Text="All panels follow one reading position. Drag a panel by its header and resize from its lower-right corner." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,22,0,0" />
                      <TextBlock Text="Click a word to reposition. Use the mouse wheel or arrow keys to move manually." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,12,0,0" />
                    </StackPanel>
                  </ScrollViewer>
                </Border>
              </TabItem>
              <TabItem Header="AI &amp; context">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel Margin="20">
                    <TextBlock Text="Context notes (saved locally and sent with questions)" TextWrapping="Wrap" />
                    <TextBox x:Name="LiveContext" AcceptsReturn="True" TextWrapping="Wrap" Height="100" MaxLength="16000" VerticalScrollBarVisibility="Auto" />
                    <Button Content="Load Markdown context…" Click="LiveMarkdown_Click" Padding="8,6" HorizontalAlignment="Left" Margin="0,6,0,8" />
                    <TextBlock Text="Fast model / reasoning effort" />
                    <DockPanel>
                      <ComboBox x:Name="LiveFastEffort" Width="90" DockPanel.Dock="Right" />
                      <TextBox x:Name="LiveFastModel" MaxLength="101" />
                    </DockPanel>
                    <TextBlock Text="Deeper model / reasoning effort" Margin="0,6,0,0" />
                    <DockPanel>
                      <ComboBox x:Name="LiveDeepEffort" Width="90" DockPanel.Dock="Right" />
                      <TextBox x:Name="LiveDeepModel" MaxLength="101" />
                    </DockPanel>
                    <Button Content="Save for next session" Click="LiveSave_Click" Padding="8,6" Margin="0,8,0,0" HorizontalAlignment="Left" />
                    <TextBlock Text="The first sentence and deeper continuation use these two models. Settings take effect on the next session." TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0" />
                  </StackPanel>
                </ScrollViewer>
              </TabItem>
              <TabItem x:Name="ShortcutsTab" Header="Shortcuts"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
<TextBlock Text="Reader shortcuts" Style="{StaticResource PageTitle}"/>
<TextBlock Text="Use these commands from any app. Include Ctrl or Alt, for example Ctrl+Alt+R. Leave a field blank to disable it." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,20"/>
<StackPanel x:Name="ShortcutRows"/>
<WrapPanel><Button Content="Save shortcuts" Click="SaveShortcuts_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"/><Button Content="Restore defaults" Click="DefaultShortcuts_Click"/></WrapPanel>
<TextBlock x:Name="ShortcutStatus" TextWrapping="Wrap" Margin="0,16,0,16"/>
<TextBlock Text="Inside a reader: Left / Right move by sentence; Up / Down move by word; Space pauses or resumes following. Global Previous / Next answer commands move between answers." TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
</StackPanel></ScrollViewer></TabItem><TabItem x:Name="StorageTab" Header="Storage">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel Margin="18">
                    <TextBlock Text="Keep your second brain safe" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="Back up after stopping your session. Pause editing in Obsidian while the snapshot is made. Each backup includes the EXE, settings, recordings, transcripts, vault and private Git history." TextWrapping="Wrap" Margin="0,8,0,12" />
                    <WrapPanel>
                      <Button Content="Create backup…" Click="Backup_Click" Padding="8,6" Margin="0,0,6,6" />
                      <Button Content="Restore backup…" Click="Restore_Click" Padding="8,6" Margin="0,0,6,6" />
                      <Button Content="Open result folder" Click="StorageOpen_Click" Padding="8,6" Margin="0,0,6,6" />
                    </WrapPanel>
                    <TextBlock Text="Folder backups use file hashes to detect missing or changed files. Restore creates a separate runnable copy. API keys remain protected for this Windows account on this PC; another PC or account needs keys configured again. Logs and runtime locks are excluded." TextWrapping="Wrap" FontSize="11" Margin="0,4,0,12" />
                    <TextBlock x:Name="StorageMessage" Text="Choose a different drive for protection against drive failure." TextWrapping="Wrap" Margin="0,0,0,12" />
                    <Button Content="Refresh storage usage" Click="StorageRefresh_Click" Padding="8,6" HorizontalAlignment="Left" />
                    <TextBlock x:Name="StorageUsage" Text="Refresh to measure local usage. Backups stored elsewhere are not included." TextWrapping="Wrap" Margin="0,8,0,16" />
                    <TextBlock Text="Saved recordings" FontWeight="SemiBold" />
                    <ListBox x:Name="StorageRecordings" Height="130" Margin="0,6,0,6" />
                    <WrapPanel>
                      <Button Content="Recover selected recording" Click="StorageRecover_Click" Padding="8,6" Margin="0,0,6,6" />
                      <Button Content="Delete selected recording…" Click="DeleteRecording_Click" Padding="8,6" Margin="0,0,6,6" />
                    </WrapPanel>
                    <TextBlock Text="Deletion removes only that recording folder. Exported vault transcripts, generated notes, history and backups remain; this is not a complete erasure of a meeting." TextWrapping="Wrap" FontSize="11" Margin="0,8,0,16" />
                    <TextBlock Text="Release qualification · preview" FontWeight="SemiBold" />
                    <TextBlock Text="Still needs your setup: a two-hour meeting, device changes, mixed monitor scaling, actual shared-screen exclusion and daily-use acceptance. Passing automated replays does not certify these checks." TextWrapping="Wrap" Margin="0,6,0,0" />
                  </StackPanel>
                </ScrollViewer>
              </TabItem>
              <TabItem x:Name="PracticeTab" Header="Practice and diagnostics">
                <Border Background="White" BorderBrush="#DFE4DA" BorderThickness="1" CornerRadius="12" Padding="20">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="*" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                      <TextBlock Text="Your script" FontSize="19" FontWeight="SemiBold" />
                      <TextBlock x:Name="ReaderState" Text="No panels" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBox x:Name="ScriptEditor" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="20000" FontSize="16" Padding="12" BorderBrush="#D8E0D4" MinHeight="100" TextChanged="ScriptEditor_Changed" AutomationProperties.Name="Script to read" />
                    <WrapPanel Grid.Row="2" Margin="0,12,0,0">
                      <Button x:Name="RecordingButton" Content="Record and transcribe" Click="Recording_Click" Padding="12,10" Margin="0,0,0,12" HorizontalAlignment="Left" FontSize="14" Style="{StaticResource PrimaryButton}" />
                      <Button Content="AI answers" Click="Assistant_Click" Padding="12,10" Margin="0,0,0,12" HorizontalAlignment="Left" FontSize="14" />
                      <Button x:Name="StreamDemoButton" Content="Incoming answers demo" Click="StreamDemo_Click" Padding="10,8" Margin="0,0,0,16" HorizontalAlignment="Left" FontSize="12" />
                      <Button Content="Apply text" Click="Apply_Click" Padding="12,8" Margin="0,0,8,6" />
                      <Button Content="Use sample" Click="Sample_Click" Padding="12,8" Margin="0,0,8,6" />
                      <Button Content="Reset position" Click="Reset_Click" Padding="12,8" Margin="0,0,0,6" />
                    </WrapPanel>
                    <WrapPanel Grid.Row="3" Margin="0,6,0,0">
                      <Button x:Name="OpenReaderButton" Content="Open reader" Click="OpenReader_Click" Padding="12,9" Margin="0,0,8,6" />
                      <Button x:Name="AddPanelButton" Content="Add panel" Click="AddPanel_Click" Padding="12,9" Margin="0,0,8,6" />
                      <Button x:Name="CloseReaderButton" Content="Close all" Click="CloseReader_Click" Padding="12,9" Margin="0,0,0,6" />
                    </WrapPanel>
                    <StackPanel Grid.Row="4" Margin="0,4,0,0">
                      <WrapPanel>
                        <Button x:Name="TimedPlay" Content="Play timed" Click="TimedPlay_Click" Padding="12,8" Margin="0,0,8,5" />
                        <Button Content="Previous sentence" Click="PreviousSentence_Click" Padding="8,8" FontSize="12" Margin="0,0,8,5" />
                        <Button Content="Next sentence" Click="NextSentence_Click" Padding="8,8" FontSize="12" Margin="0,0,0,5" />
                      </WrapPanel>
                      <DockPanel Margin="0,2,0,7">
                        <TextBlock Text="{Binding ElementName=SpeedSlider, Path=Value, StringFormat={}{0:F0} WPM}" DockPanel.Dock="Right" FontSize="12" Width="70" TextAlignment="Right" />
                        <Slider x:Name="SpeedSlider" Minimum="60" Maximum="300" Value="150" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="Speed_Changed" AutomationProperties.Name="Timed scrolling speed" />
                      </DockPanel>
                      <TextBlock x:Name="PlaybackLabel" Text="Timed scrolling paused" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,7" />
                      <Button x:Name="PracticeListenButton" Content="Follow practice script" Click="PracticeListen_Click" Padding="12,8" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" />
                      <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="MicLabel" Text="Mic off" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <ProgressBar x:Name="MicLevel" Grid.Column="1" Minimum="0" Maximum="100" Height="5" Foreground="#639773" Background="#E5EBDF" BorderThickness="0" />
                      </Grid>
                    </StackPanel>
                    <TextBlock x:Name="HeardText" Grid.Row="5" Text="Recognized words will appear here." TextWrapping="Wrap" MaxHeight="45" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,12,0,0" />
                    <TextBlock x:Name="StatusText" Grid.Row="6" Text="Start sends the selected microphone to Deepgram. Audio is not saved locally." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,8,0,0" />
                  </Grid>
                </Border>
              </TabItem>
            </TabControl>
          </TabItem>
        </TabControl>
      </Grid>
    </ScrollViewer>
    <DockPanel Grid.Row="3" Margin="0,16,0,0">
      <TextBlock Text="RECORD · TRANSCRIBE · ANSWER · FOLLOW" FontSize="10" Foreground="{StaticResource Muted}" />
      <TextBlock x:Name="VersionText" Text="v0.22.0" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" />
    </DockPanel>
  </Grid>
</Window>
