<Window x:Class="SecondBrain.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Second Brain" Style="{StaticResource ShellWindowStyle}" Width="640" Height="570" MinWidth="540" MinHeight="520" WindowStartupLocation="CenterScreen">
  <Grid Margin="32">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel>
      <TextBlock Text="SECOND BRAIN" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
      <Border HorizontalAlignment="Right" Background="#E3EBDC" CornerRadius="10" Padding="10,4"><TextBlock Text="LOCAL · OFFLINE" FontSize="10" FontWeight="SemiBold" /></Border>
    </DockPanel>
    <StackPanel Grid.Row="1" Margin="0,30,0,24">
      <TextBlock Text="A quiet place to begin." FontSize="30" FontWeight="SemiBold" />
      <TextBlock Text="Your reader workspace starts here." Foreground="{StaticResource Muted}" FontSize="15" Margin="0,10,0,0" />
    </StackPanel>
    <Border Grid.Row="2" Background="White" BorderBrush="#DFE4DA" BorderThickness="1" CornerRadius="12" Padding="24">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel><TextBlock Text="Reader panel" FontSize="20" FontWeight="SemiBold" /><TextBlock x:Name="ReaderState" Text="Closed" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Muted}" /></DockPanel>
        <TextBlock Grid.Row="1" Text="Open an empty floating panel. Text and playback arrive in the next stages." TextWrapping="Wrap" FontSize="14" Foreground="{StaticResource Muted}" Margin="0,10,0,20" />
        <StackPanel Grid.Row="2" Orientation="Horizontal">
          <Button x:Name="OpenReaderButton" Content="Open reader" Click="OpenReader_Click" Background="#294C3E" Foreground="White" BorderBrush="#294C3E" />
          <Button x:Name="CloseReaderButton" Content="Close reader" Click="CloseReader_Click" Margin="10,0,0,0" IsEnabled="False" />
        </StackPanel>
        <CheckBox x:Name="RememberPosition" Grid.Row="3" Content="Remember reader position" FontSize="13" Margin="0,22,0,0" Checked="RememberPosition_Changed" Unchecked="RememberPosition_Changed" />
        <TextBlock x:Name="StatusText" Grid.Row="4" Text="Ready when you are." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,18,0,0" />
      </Grid>
    </Border>
    <DockPanel Grid.Row="3" Margin="0,18,0,0">
      <TextBlock Text="SPRINT 0  /  FOUNDATION" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
      <TextBlock x:Name="VersionText" Text="v0.1.0" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
    </DockPanel>
  </Grid>
</Window>
