<Window x:Class="SecondBrain.App.ReaderWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Second Brain · Reader" Style="{StaticResource ShellWindowStyle}" Width="620" Height="420" MinWidth="340" MinHeight="260"
        Background="Transparent" AllowsTransparency="True" WindowStyle="None" ResizeMode="CanResize" Topmost="True" WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False" ShowActivated="False" PreviewKeyDown="Reader_KeyDown">
  <Window.Resources><Style TargetType="Button" BasedOn="{StaticResource QuietReaderButton}"/></Window.Resources>
  <Border x:Name="Surface" CornerRadius="12" BorderBrush="#597769" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/><RowDefinition Height="75"/></Grid.RowDefinitions>
      <Grid x:Name="HeaderChrome" Background="Transparent" MouseLeftButtonDown="Title_MouseDown" Margin="14,0,8,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="READER   ·   drag to move" Foreground="#B5CDBD" FontSize="11" VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="Reset" Click="Reset_Click" Padding="10,5" FontSize="11" Background="#294C3E" Foreground="White" BorderThickness="0" Margin="0,0,6,0" />
        <Button Grid.Column="2" Content="✕" Click="Close_Click" Padding="10,5" FontSize="12" Background="#294C3E" Foreground="White" BorderThickness="0" AutomationProperties.Name="Close reader panel" />
      </Grid>
      <Grid Grid.Row="1" ClipToBounds="True" x:Name="ReadingArea">
        <Canvas IsHitTestVisible="False"><Border x:Name="Band" Height="3" Width="20" Background="#B9DA98" CornerRadius="1" Canvas.Left="8" /></Canvas>
        <Border Padding="32,0" PreviewMouseWheel="Reader_MouseWheel" Background="Transparent">
          <Canvas>
          <StackPanel x:Name="ReaderContent">
            <StackPanel.RenderTransform><TranslateTransform x:Name="TextTranslation"/></StackPanel.RenderTransform>
            <Border x:Name="TopSpace" Height="70" />
            <TextBlock x:Name="ScriptText" Foreground="#EDF3E9" FontFamily="Segoe UI" FontSize="32" TextWrapping="Wrap" HorizontalAlignment="Center" LineStackingStrategy="BlockLineHeight" />
            <StackPanel x:Name="StreamBlocks" />
          </StackPanel>
          </Canvas>
        </Border>
      </Grid>
      <Grid x:Name="FooterChrome" Grid.Row="2" Margin="14,3,24,8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="ProgressText" Foreground="#B5CDBD" FontSize="11" />
        <TextBlock x:Name="CaptureText" Grid.Row="1" Grid.ColumnSpan="2" Foreground="#ABC3B3" FontSize="10" Text="Checking capture exclusion…" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
        <TextBlock Grid.Column="1" Text="Click a word to reposition" Foreground="#B5CDBD" FontSize="10" VerticalAlignment="Center" />
        <WrapPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,5,0,0">
          <Button Content="Previous" Click="Previous_Click" Padding="8,3" FontSize="11" ToolTip="Previous sentence (Left arrow)"/>
          <Button x:Name="ReaderPlay" Content="Play timed" Click="Play_Click" Padding="8,3" FontSize="11" Margin="6,0" ToolTip="Pause voice following, or play/pause timed scrolling (Space)"/>
          <Button Content="Next" Click="Next_Click" Padding="8,3" FontSize="11" ToolTip="Next sentence (Right arrow)"/>
        </WrapPanel>
      </Grid>
      <Thumb x:Name="ResizeGrip" Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="22" Height="22" Cursor="SizeNWSE" DragDelta="Resize_DragDelta" AutomationProperties.Name="Resize reader">
        <Thumb.Template><ControlTemplate><Border Background="Transparent"><TextBlock Text="◢" Foreground="#8BAF98" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" /></Border></ControlTemplate></Thumb.Template>
      </Thumb>
    </Grid>
  </Border>
</Window>
