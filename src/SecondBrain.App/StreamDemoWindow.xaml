<Window x:Class="SecondBrain.App.StreamDemoWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Second Brain · Incoming answers" Style="{StaticResource ShellWindowStyle}" Width="720" Height="560" MinWidth="540" MinHeight="420" WindowStartupLocation="CenterOwner">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Incoming answers" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Simulated text · no AI calls. Each run queues three answers. Closing restores your script. Demo history is temporary." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,8,0,16"/></StackPanel>
    <WrapPanel Grid.Row="1" Margin="0,0,0,12"><Button x:Name="RunButton" Content="Start demo" Click="Run_Click" Padding="12,8" Margin="0,0,8,6"/><Button Content="Stop incoming text" Click="Stop_Click" Padding="12,8" Margin="0,0,8,6"/><Button Content="Return to my script" Click="Return_Click" Padding="12,8" Margin="0,0,0,6"/></WrapPanel>
    <ListBox x:Name="AnswersList" Grid.Row="2" AutomationProperties.Name="Answer queue" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
    <StackPanel Grid.Row="3" Margin="0,12,0,0"><WrapPanel><Button x:Name="ReadButton" Content="Read selected answer" Click="Read_Click" Padding="12,8" Margin="0,0,8,6"/><Button Content="Previous answer" Click="Previous_Click" Padding="12,8" Margin="0,0,8,6"/><Button Content="Next answer" Click="Next_Click" Padding="12,8" Margin="0,0,0,6"/></WrapPanel><TextBlock x:Name="ActiveText" Text="Start a demo to read its first answer." FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
    <TextBlock x:Name="Status" Grid.Row="4" Text="Use Play timed or Start listening in the main window. Answers change only when you choose one. Manual repositioning pauses timed playback." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,12,0,0"/>
  </Grid>
</Window>
